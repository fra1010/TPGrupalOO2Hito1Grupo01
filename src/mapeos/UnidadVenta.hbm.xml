<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="datos.UnidadVenta" table="unidad_venta">
		<id column="id_unidad_venta" name="idUnidadVenta">
			<generator class="identity"></generator>
		</id>
		<property name="nombre" column="nombre" type="string"></property>
		<property name="superficie" column="superficie" type="double"></property>
		<property name="codigo" column="codigo" type="string"></property>


		<many-to-one name="responsable" column="responsable_id"
			class="datos.Empleado" unique="true" />


		<set name="empleados" table="empleado" order-by="id_empleado asc"
			inverse="true" lazy="true" fetch="select">
			<key column="unidad_venta_id" not-null="false" />
			<one-to-many class="datos.Empleado" />
		</set>

		<!-- <set name="pedidos" table="pedido" order-by="id_pedido asc" -->
		<!-- inverse="true" lazy="true" fetch="select"> -->
		<!-- <key column="unidad_venta_id" not-null="true" /> -->
		<!-- <one-to-many class="datos.Pedido" /> -->
		<!-- </set> -->

		<!-- <set name="platos" table="plato" order-by="id_plato asc" -->
		<!-- inverse="true" lazy="true" fetch="select"> -->
		<!-- <key column="unidad_venta_id" not-null="true" /> -->
		<!-- <one-to-many class="datos.Plato" /> -->
		<!-- </set> -->
		<joined-subclass name="datos.FoodTruck"
			table="food_truck">
			<key column="id_unidad_venta" />
			<property column="patente" name="patente" type="string" />
			<property column="conexion" name="conexion" type="boolean" />
		</joined-subclass>
		<joined-subclass name="datos.PuestoDesarmable"
			table="puesto_desarmable">
			<key column="id_unidad_venta" />
			<property column="cantidad_carpa" name="cantidadCarpas"
				type="int" />
			<property column="tiempo" name="tiempo" type="int" />
		</joined-subclass>
	</class>


</hibernate-mapping>