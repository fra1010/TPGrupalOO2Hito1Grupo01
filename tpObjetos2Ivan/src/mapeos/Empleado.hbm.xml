<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
	
	<class name="datos.Empleado" table="empleado">
		
		<id column="id" name="id">
			<generator class="identity" />
		</id>
		
		<property name="nombre" column="nombre" type="string"/>
		<property name="apellido" column="apellido" type="string" />
		<property name="dni" column="dni" type="long" />
		<property name="fechaNacimiento" column="fechaNacimiento" type="java.time.LocalDate" />
		<property name="ingreso" column="ingreso" type="java.time.LocalDate" />
	
       <joined-subclass name="datos.Cocinero" table="cocinero">
			<key column="id" />
			<property column="especialidad" name="especialidad" type="string" />
		</joined-subclass>

		<joined-subclass name="datos.Cajero" table="cajero">
			<key column="id" />
			<property column="turno" name="turno" type="string" />
		</joined-subclass>

     </class> 
     
</hibernate-mapping>

